# ===========================================
# WalletSourceDB Configuration
# ===========================================

# Helius API (Solana RPC + WebSocket)
SOLANA_WSS_URL=wss://atlas-mainnet.helius-rpc.com?api-key=YOUR_HELIUS_KEY
HELIUS_API_KEY=YOUR_HELIUS_KEY
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql://walletsource:walletsource_dev@localhost:5432/walletsource

# Pump.fun Program ID (mainnet)
PUMP_FUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# Trading Mode
DRY_RUN=true

# Wallet (required for live trading only)
# WALLET_PRIVATE_KEY=your_base58_private_key

# API Rate Limits
DEXSCREENER_RATE_LIMIT=300

# Logging
LOG_LEVEL=info

# Taint & Scoring Parameters
TAINT_DECAY_WEEKLY=0.95
SIGMOID_K_CONFIDENCE=6.0
SIGMOID_ALPHA_PEXIT=3.0
SIGMOID_MU_TAINT=100
