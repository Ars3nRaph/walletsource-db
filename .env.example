# Helius API
HELIUS_API_KEY=your_helius_api_key
SOLANA_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/walletsource

# Pump.fun
PUMP_FUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# API Rate Limits
DEXSCREENER_RATE_LIMIT=300  # requests per minute (official DexScreener limit)

# Logging
LOG_LEVEL=info

# Taint & Scoring Parameters
TAINT_DECAY_WEEKLY=0.95
SIGMOID_K_CONFIDENCE=6.0
SIGMOID_ALPHA_PEXIT=3.0
SIGMOID_MU_TAINT=100
SIGMOID_SIGMA_TAINT=40

# Calibration
CALIBRATION_CRON=0 3 * * 0
CALIBRATION_GUARD_PCT=0.50
PAPER_TRADING_MODE=true
PAPER_TRADING_LOG_FILE=./data/paper-trades.log

# Live Trading (DRY_RUN mode)
LIVE_TRADING=true
DRY_RUN=true
TRADING_PRIVATE_KEY=your_base58_private_key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
MAX_POSITION_SOL=0.5
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_SOL=3.0
SLIPPAGE_BPS=1500
JITO_TIP_BUY_LAMPORTS=100000
JITO_TIP_SELL_LAMPORTS=100000

# Helius WebSocket (primary) — Professional plan 10M credits/month
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Daily credit budget (10M/month ≈ 333K/day, keep 20% reserve)
HELIUS_DAILY_CREDIT_LIMIT=270000

# Dashboard auth
DASHBOARD_USER=your_username
DASHBOARD_PASS=your_password
TRADING_WALLET_ADDRESS=your_wallet_public_key
