import { describe, it, expect, beforeEach, vi } from 'vitest';
import { createTestDb } from '../setup.js';
import { TradeExecutor } from '../../src/execution/TradeExecutor.js';
import { WalletRepo } from '../../src/repositories/WalletRepo.js';
import { TokenEventRepo } from '../../src/repositories/TokenEventRepo.js';
import { PlaybookBuilder } from '../../src/scoring/PlaybookBuilder.js';
import type { IMemoryDb } from 'pg-mem';
import type { Pool } from 'pg';

// Mock PExitCalculator for fallback tests
vi.mock('../../src/scoring/PExitCalculator.js', () => {
  return {
    PExitCalculator: vi.fn().mockImplementation(() => ({
      recalculatePExit: vi.fn().mockResolvedValue({ pExitV1: 1.2, pExitV2: 0.75 }),
      getExitActionV2: vi.fn().mockReturnValue({ action: 'SELL', sellPct: 75 })
    }))
  };
});

describe('TradeExecutor', () => {
  let db: IMemoryDb;
  let pool: Pool;
  let executor: TradeExecutor;
  let walletRepo: WalletRepo;
  let tokenRepo: TokenEventRepo;
  let playbookBuilder: PlaybookBuilder;

  beforeEach(async () => {
    db = await createTestDb();
    pool = new (db.adapters.createPg().Pool)() as unknown as Pool;
    executor = new TradeExecutor(pool);
    walletRepo = new WalletRepo(pool);
    tokenRepo = new TokenEventRepo(pool);
    playbookBuilder = new PlaybookBuilder(pool);
  });

  describe('RIDE strategy', () => {
    beforeEach(async () => {
      // Create wallet with RIDE playbook
      await walletRepo.upsertWallet('rideRugger');

      // Create 5 consistent rugs
      const rugs = [
        { token: 'rug1', peak_mc: 50000, time_to_peak: 5.0, time_to_rug: 10.0 },
        { token: 'rug2', peak_mc: 51000, time_to_peak: 5.1, time_to_rug: 10.1 },
        { token: 'rug3', peak_mc: 49000, time_to_peak: 4.9, time_to_rug: 9.9 },
        { token: 'rug4', peak_mc: 50500, time_to_peak: 5.05, time_to_rug: 10.05 },
        { token: 'rug5', peak_mc: 49500, time_to_peak: 4.95, time_to_rug: 9.95 }
      ];

      for (const rug of rugs) {
        await tokenRepo.recordEvent(rug.token, 'rideRugger');
        await pool.query(
          `UPDATE token_events
           SET verdict = 'RUG_METRICS',
               peak_mc = $1,
               time_to_peak_min = $2,
               time_to_rug_min = $3,
               checked_at = NOW()
           WHERE token_address = $4`,
          [rug.peak_mc, rug.time_to_peak, rug.time_to_rug, rug.token]
        );
      }

      // Build playbook (should be RIDE with consistency > 0.7)
      await playbookBuilder.buildPlaybook('rideRugger');

      // Create new token to trade
      await tokenRepo.recordEvent('newToken', 'rideRugger');
    });

    it('should signal BUY during entry window', async () => {
      // Elapsed = 3 min (before entry_window_end ~= 5 - std ~= 5 - 0.06 = 4.94)
      const signal = await executor.evaluateTrade('newToken', 3.0, 50000);

      expect(signal.action).toBe('BUY');
      expect(signal.confidence).toBeGreaterThan(0.7); // High consistency
      expect(signal.percentage).toBe(100);
      expect(signal.playbook_strategy).toBe('RIDE');
      expect(signal.reason).toContain('Entry window');
    });

    it('should signal HOLD during hold period', async () => {
      // Elapsed = 7 min (between entry_end and exit_start)
      const signal = await executor.evaluateTrade('newToken', 7.0, 50000);

      expect(signal.action).toBe('HOLD');
      expect(signal.percentage).toBe(0);
      expect(signal.playbook_strategy).toBe('RIDE');
      expect(signal.reason).toContain('Hold period');
    });

    it('should signal progressive SELL during exit window', async () => {
      // With very low std (~0.06), exit_window_start ~= 9.94, exit_window_end = 10.0
      // Elapsed = 9.97 min (in exit window)
      const signal = await executor.evaluateTrade('newToken', 9.97, 50000);

      expect(signal.action).toBe('SELL');
      expect(signal.percentage).toBeGreaterThan(0);
      expect(signal.percentage).toBeLessThanOrEqual(100);
      expect(signal.playbook_strategy).toBe('RIDE');
      expect(signal.reason).toContain('Exit window');
    });

    it('should signal SELL 100% past exit window', async () => {
      // Elapsed = 12 min (past exit_window_end ~= 10)
      const signal = await executor.evaluateTrade('newToken', 12.0, 50000);

      expect(signal.action).toBe('SELL');
      expect(signal.confidence).toBe(1.0);
      expect(signal.percentage).toBe(100);
      expect(signal.playbook_strategy).toBe('RIDE');
      expect(signal.reason).toContain('Past exit window');
    });
  });

  describe('FADE strategy', () => {
    beforeEach(async () => {
      // Create wallet with FADE playbook (moderate consistency)
      await walletRepo.upsertWallet('fadeRugger');

      // Create 5 rugs with moderate consistency
      const rugs = [
        { token: 'rug1', peak_mc: 50000, time_to_peak: 5.0, time_to_rug: 10.0 },
        { token: 'rug2', peak_mc: 52000, time_to_peak: 5.5, time_to_rug: 11.0 },
        { token: 'rug3', peak_mc: 48000, time_to_peak: 4.5, time_to_rug: 9.0 },
        { token: 'rug4', peak_mc: 51000, time_to_peak: 5.2, time_to_rug: 10.5 },
        { token: 'rug5', peak_mc: 49000, time_to_peak: 4.8, time_to_rug: 9.5 }
      ];

      for (const rug of rugs) {
        await tokenRepo.recordEvent(rug.token, 'fadeRugger');
        await pool.query(
          `UPDATE token_events
           SET verdict = 'RUG_METRICS',
               peak_mc = $1,
               time_to_peak_min = $2,
               time_to_rug_min = $3,
               checked_at = NOW()
           WHERE token_address = $4`,
          [rug.peak_mc, rug.time_to_peak, rug.time_to_rug, rug.token]
        );
      }

      // Build playbook
      await playbookBuilder.buildPlaybook('fadeRugger');

      // Update strategy to FADE if needed (could be RIDE depending on exact CV)
      // For test purposes, manually override if needed
      const wallet = await walletRepo.getByAddress('fadeRugger');
      if (wallet?.rugger_playbook) {
        const playbook = typeof wallet.rugger_playbook === 'string'
          ? JSON.parse(wallet.rugger_playbook)
          : wallet.rugger_playbook;

        // Force FADE strategy for this test
        playbook.recommended_strategy = 'FADE';
        await walletRepo.updatePlaybook('fadeRugger', playbook);
      }

      // Create new token to trade
      await tokenRepo.recordEvent('newToken', 'fadeRugger');
    });

    it('should signal NONE before peak', async () => {
      // Elapsed = 3 min (before short_window_start ~= 5)
      const signal = await executor.evaluateTrade('newToken', 3.0, 50000);

      expect(signal.action).toBe('NONE');
      expect(signal.percentage).toBe(0);
      expect(signal.playbook_strategy).toBe('FADE');
      expect(signal.reason).toContain('Before peak');
    });

    it('should signal SHORT at peak', async () => {
      // Elapsed = 5.2 min (at short_window_start)
      const signal = await executor.evaluateTrade('newToken', 5.2, 50000);

      expect(signal.action).toBe('SHORT');
      expect(signal.percentage).toBe(100);
      expect(signal.playbook_strategy).toBe('FADE');
      expect(signal.reason).toContain('Peak short entry');
    });

    it('should signal HOLD_SHORT during dump', async () => {
      // Elapsed = 7 min (between short_window_start and short_window_end)
      const signal = await executor.evaluateTrade('newToken', 7.0, 50000);

      expect(signal.action).toBe('HOLD_SHORT');
      expect(signal.percentage).toBe(0);
      expect(signal.playbook_strategy).toBe('FADE');
      expect(signal.reason).toContain('Hold short');
    });

    it('should signal COVER after dump', async () => {
      // Elapsed = 10 min (past short_window_end)
      const signal = await executor.evaluateTrade('newToken', 10.0, 50000);

      expect(signal.action).toBe('COVER');
      expect(signal.percentage).toBe(100);
      expect(signal.playbook_strategy).toBe('FADE');
      expect(signal.reason).toContain('Cover short');
    });
  });

  describe('Fallback to PExitCalculator', () => {
    it('should fallback when wallet has no playbook', async () => {
      // Create wallet without playbook
      await walletRepo.upsertWallet('noPlaybookWallet');
      await tokenRepo.recordEvent('token1', 'noPlaybookWallet');

      const signal = await executor.evaluateTrade('token1', 5.0, 50000);

      expect(signal.fallback).toBe(true);
      expect(signal.reason).toContain('No playbook');
      expect(signal.reason).toContain('P_exit');
    });

    it('should fallback for WATCH strategy', async () => {
      // Create wallet with WATCH playbook (< 5 rugs)
      await walletRepo.upsertWallet('watchWallet');

      const rugs = [
        { token: 'rug1', peak_mc: 50000, time_to_peak: 5.0, time_to_rug: 10.0 },
        { token: 'rug2', peak_mc: 51000, time_to_peak: 5.1, time_to_rug: 10.1 },
        { token: 'rug3', peak_mc: 49000, time_to_peak: 4.9, time_to_rug: 9.9 }
      ];

      for (const rug of rugs) {
        await tokenRepo.recordEvent(rug.token, 'watchWallet');
        await pool.query(
          `UPDATE token_events
           SET verdict = 'RUG_METRICS',
               peak_mc = $1,
               time_to_peak_min = $2,
               time_to_rug_min = $3,
               checked_at = NOW()
           WHERE token_address = $4`,
          [rug.peak_mc, rug.time_to_peak, rug.time_to_rug, rug.token]
        );
      }

      await playbookBuilder.buildPlaybook('watchWallet'); // Should be WATCH (sample < 5)
      await tokenRepo.recordEvent('newToken', 'watchWallet');

      const signal = await executor.evaluateTrade('newToken', 5.0, 50000);

      expect(signal.fallback).toBe(true);
      expect(signal.playbook_strategy).toBe('WATCH');
      expect(signal.reason).toContain('WATCH');
      expect(signal.reason).toContain('P_exit');
    });

    it('should fallback for AVOID strategy', async () => {
      // Create wallet with AVOID playbook (avg_time_to_rug < 3)
      await walletRepo.upsertWallet('avoidWallet');

      const rugs = [
        { token: 'rug1', peak_mc: 30000, time_to_peak: 0.5, time_to_rug: 1.0 },
        { token: 'rug2', peak_mc: 32000, time_to_peak: 0.6, time_to_rug: 1.2 },
        { token: 'rug3', peak_mc: 28000, time_to_peak: 0.4, time_to_rug: 0.8 },
        { token: 'rug4', peak_mc: 31000, time_to_peak: 0.55, time_to_rug: 1.1 },
        { token: 'rug5', peak_mc: 29000, time_to_peak: 0.45, time_to_rug: 0.9 }
      ];

      for (const rug of rugs) {
        await tokenRepo.recordEvent(rug.token, 'avoidWallet');
        await pool.query(
          `UPDATE token_events
           SET verdict = 'RUG_METRICS',
               peak_mc = $1,
               time_to_peak_min = $2,
               time_to_rug_min = $3,
               checked_at = NOW()
           WHERE token_address = $4`,
          [rug.peak_mc, rug.time_to_peak, rug.time_to_rug, rug.token]
        );
      }

      await playbookBuilder.buildPlaybook('avoidWallet'); // Should be AVOID (avg_time_to_rug < 3)
      await tokenRepo.recordEvent('newToken', 'avoidWallet');

      const signal = await executor.evaluateTrade('newToken', 5.0, 50000);

      expect(signal.fallback).toBe(true);
      expect(signal.playbook_strategy).toBe('AVOID');
      expect(signal.reason).toContain('AVOID');
      expect(signal.reason).toContain('P_exit');
    });
  });

  describe('Edge cases', () => {
    it('should handle token not found', async () => {
      const signal = await executor.evaluateTrade('nonExistentToken', 5.0, 50000);

      expect(signal.action).toBe('NONE');
      expect(signal.confidence).toBe(0);
      expect(signal.reason).toContain('Token not found');
    });

    it('should handle wallet not found (cascades to token not found)', async () => {
      // When wallet is deleted, token is also deleted due to ON DELETE CASCADE
      await pool.query(
        `INSERT INTO wallet_profiles (wallet_address) VALUES ('ghostWallet')`
      );
      await tokenRepo.recordEvent('orphanToken', 'ghostWallet');
      await pool.query(
        `DELETE FROM wallet_profiles WHERE wallet_address = 'ghostWallet'`
      );

      // Token should also be deleted due to FK constraint
      const signal = await executor.evaluateTrade('orphanToken', 5.0, 50000);

      expect(signal.action).toBe('NONE');
      expect(signal.confidence).toBe(0);
      expect(signal.reason).toContain('Token not found'); // Cascaded deletion
    });

    it('should handle zero-duration exit window gracefully', async () => {
      // Create wallet and playbook manually with edge case values
      await walletRepo.upsertWallet('edgeWallet');
      await tokenRepo.recordEvent('edgeToken', 'edgeWallet');

      // Create playbook with exit_window_start === exit_window_end
      const edgePlaybook = {
        sample_size: 5,
        avg_time_to_peak_min: 5.0,
        std_time_to_peak_min: 0,
        avg_peak_mc: 50000,
        std_peak_mc: 0,
        avg_time_to_rug_min: 10.0,
        std_time_to_rug_min: 0,
        avg_dump_speed: -10,
        avg_liquidity_at_peak: 8000,
        consistency_score: 0.9,
        entry_window_end_min: 5.0,
        exit_window_start_min: 10.0, // Same as exit_window_end
        exit_window_end_min: 10.0,
        short_window_start_min: 5.0,
        short_window_end_min: 10.0,
        recommended_strategy: 'RIDE' as const
      };

      await walletRepo.updatePlaybook('edgeWallet', edgePlaybook);

      // Test at exit window
      const signal = await executor.evaluateTrade('edgeToken', 10.0, 50000);

      expect(signal.action).toBe('SELL');
      expect(signal.percentage).toBe(100); // Should handle division by zero
    });
  });
});
