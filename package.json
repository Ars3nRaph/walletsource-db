{
  "name": "walletsource-db",
  "version": "4.0.0",
  "description": "On-chain wallet forensic intelligence database",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node -e \"require('fs').cpSync('src/db/schema.sql', 'dist/src/db/schema.sql')\"",
    "start": "node --max-old-space-size=8192 dist/src/index.js",
    "start:dev": "tsx --watch src/index.ts",
    "validate": "node dist/src/validate.js",
    "prod:validate": "tsx scripts/prod-validation.ts",
    "prod:build": "npm run type-check && npm run lint && npm run build",
    "prod:deploy": "npm run prod:build && npm run prod:validate",
    "db:setup": "bash scripts/setup-db.sh",
    "db:start": "docker-compose up -d postgres",
    "db:stop": "docker-compose down",
    "db:reset": "docker-compose down -v && npm run db:setup",
    "paper:start": "bash scripts/start-paper-trading.sh",
    "paper:stats": "cat data/paper-trades.log | jq -s 'group_by(.action) | map({action: .[0].action, count: length}) | sort_by(.count) | reverse'",
    "monitor": "bash scripts/monitor.sh",
    "watch:tokens": "bash scripts/watch-tokens.sh",
    "watch:snapshots": "bash scripts/watch-snapshots.sh",
    "watch:trades": "bash scripts/watch-paper-trades.sh",
    "show:playbooks": "bash scripts/show-playbook-diversity.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "solana",
    "forensics",
    "wallet",
    "blockchain",
    "pump.fun"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@pump-fun/pump-sdk": "^1.32.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/pg": "^8.10.9",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.1",
    "eslint": "^8.56.0",
    "pg-mem": "^2.8.1",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
